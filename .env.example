# Public integration values copied into the browser bundle. Never place secrets here.
VITE_ABLE_BASE_URL=https://able-test.ithreexglobal.com
VITE_ABLE_CHAT_ID=YOUR_CHAT_ID
# Kiosk mode (totem). Bundled into the browser: accepted risk, see docs/22-kiosco-avatar-plan.md.
# The real key comes from the agenthreex team through a secure channel; never commit it.
VITE_KIOSK_KEY=YOUR_KIOSK_KEY
# Optional, 15-3600, default 60.
VITE_KIOSK_IDLE_SECONDS=60
